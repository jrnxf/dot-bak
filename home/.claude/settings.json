{
  "permissions": {
    "allow": [
      "Bash(git worktree:*)",
      "Bash(git add:*)",
      "Bash(npx tsc:*)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(git commit:*)",
      "WebFetch(domain:www.mapcn.dev)",
      "Bash(bun run build:*)",
      "Bash(timeout 30 bun run dev:*)",
      "Bash(bunx tsc:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(bun run typecheck:*)",
      "Bash(timeout 15 bun run dev:*)",
      "Bash(curl:*)",
      "Bash(bun run dev:*)",
      "Bash(pkill:*)",
      "Bash(bun run:*)",
      "Bash(git reset:*)",
      "Bash(npm run lint:*)",
      "Bash(bun add:*)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch"
    ],
    "deny": [
      "Read(//Volumes/files/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "lavish-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gh-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "chrome-devtools-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jrnxf/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jrnxf/.claude/hooks/notify.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jrnxf/.claude/hooks/notify.sh'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "pogo@pogo": true,
    "ruby-lsp@claude-plugins-official": true,
    "caveman@caveman": true,
    "cloudflare@cloudflare": true
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "pogo": {
      "source": {
        "source": "github",
        "repo": "PocusHQ/pogo"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
