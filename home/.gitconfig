[user]
    name = Colby Thomas
    email = colby@jrnxf.co
[pull]
	ff = only
[alias]
	s = status -s
	ss = status
	l = log --stat
	lo = log --oneline
	d = diff
	c = commit
	a = add
	f = fetch
	rb = rebase
	co = checkout
	g = grep
	rs = reset
	p = pull
	b = branch
[init]
	defaultBranch = main
[core]
	excludesfile = ~/.gitignore
[diff]
	tool = vimdiff
[difftool]
	prompt = false
[push]
	autoSetupRemote = true
[credential "https://github.com"]
	# The Linux machine clones over https; on the Mac the remote is ssh and this is unused.
	helper =
	helper = !gh auth git-credential
[includeIf "gitdir:~/dotfiles/"]
	path = ~/dotfiles/.githooks/gitconfig
