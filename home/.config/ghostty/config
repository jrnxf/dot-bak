window-padding-balance = true
cursor-style = block
font-family = GeistMono Nerd Font
font-size = 15
mouse-hide-while-typing = true
copy-on-select = false
macos-titlebar-style = tabs
window-colorspace = display-p3
window-padding-x = 16
window-padding-y = 16
keybind = ctrl+a>n=new_window
keybind = ctrl+a>h=goto_split:left
keybind = ctrl+a>l=goto_split:right
keybind = ctrl+a>space=equalize_splits
keybind = ctrl+enter=clear_screen
keybind = global:cmd+grave_accent=toggle_quick_terminal
keybind = ctrl+a>t=close_surface
macos-icon = custom-style
macos-icon-ghost-color = 4595AD
macos-icon-screen-color = 0B1B1D
keybind = shift+enter=text:\n
theme = Cursor Dark
shell-integration-features = ssh-env,ssh-terminfo
# Smooth cursor glide shader. To turn it off, comment out the custom-shader line.
custom-shader = shaders/cursor-glide.glsl
